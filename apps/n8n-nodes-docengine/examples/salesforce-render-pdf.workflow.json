{
  "name": "DocEngine — Salesforce PDF render",
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "Salesforce DocEngine_Pdf compatible: POST /api/v1/render/pdf → join template + values → PDF bytes."
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "api/v1/render/pdf",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-sf-pdf",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "docengine-sf-render-pdf",
      "notesInFlow": true,
      "notes": "Named Credential DocEngine_Pdf URL = this n8n origin (no trailing slash). Apex appends /api/v1/render/pdf."
    },
    {
      "parameters": {
        "templateSource": "incoming",
        "templateJsonPath": "body.template",
        "valuesJsonPath": "body.document",
        "useTemplateFieldMapping": false,
        "hideEmptyValues": false,
        "outputFormat": "pdf",
        "fileName": "document.pdf",
        "binaryPropertyName": "data"
      },
      "id": "docengine-values",
      "name": "DocEngine",
      "type": "n8n-nodes-docengine.docEngine",
      "typeVersion": 5,
      "position": [260, 300],
      "notesInFlow": true,
      "notes": "SF template + values: body.template + body.document → PDF. Requires n8n-nodes-docengine."
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseBinaryPropertyName": "data",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/pdf"
              },
              {
                "name": "Content-Disposition",
                "value": "inline; filename=\"document.pdf\""
              }
            ]
          }
        }
      },
      "id": "respond-pdf",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 300],
      "notesInFlow": true,
      "notes": "Apex expects raw PDF bytes (getBodyAsBlob). Do not return JSON or base64."
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
