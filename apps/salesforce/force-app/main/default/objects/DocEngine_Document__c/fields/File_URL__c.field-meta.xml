<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>File_URL__c</fullName>
    <description>Lightning preview URL for the attached ContentDocument.</description>
    <externalId>false</externalId>
    <formula>IF(
  ISBLANK(Content_Document_Id__c),
  NULL,
  HYPERLINK(
    &quot;/lightning/r/ContentDocument/&quot; &amp; Content_Document_Id__c &amp; &quot;/view&quot;,
    &quot;Preview&quot;,
    &quot;_blank&quot;
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>File</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
